# Reeveri API (Express + multer). Build context: repo root.
FROM node:22-alpine AS deps
WORKDIR /app
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=4000 \
    DATA_DIR=/data/db \
    UPLOAD_DIR=/data/uploads
COPY --from=deps /app/node_modules ./node_modules
# index.js plus the bundled seed content (server/data/db.json, server/uploads/seed), copied on first run.
COPY server/index.js server/package.json ./
COPY server/data ./data
COPY server/uploads/seed ./uploads/seed
# Uploads and the JSON database live here: mount a persistent volume at /data.
RUN mkdir -p /data/db /data/uploads && chown -R node:node /data /app
USER node
VOLUME ["/data"]
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD wget -qO- http://127.0.0.1:4000/api/health >/dev/null || exit 1
CMD ["node", "index.js"]
