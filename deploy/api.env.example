# API (Dockerfile.api). Set in Dokploy for the API app.
PORT=4000

# Admin login for /admin. Change both before going live.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-password

# Long random string used to sign login tokens, e.g. `openssl rand -hex 32`.
TOKEN_SECRET=change-me-to-a-long-random-string

# Website origin(s) allowed to call the API, comma separated. Leave empty to allow any origin.
CORS_ORIGIN=https://example.com

# Already set in the image; override only if you mount the volume elsewhere.
# DATA_DIR=/data/db
# UPLOAD_DIR=/data/uploads
