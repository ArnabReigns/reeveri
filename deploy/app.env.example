# Dokploy > your app > Environment. Copy these and set real values.
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-password
# Long random string that signs login tokens: openssl rand -hex 32
TOKEN_SECRET=change-me-to-a-long-random-string
# Already set in the Dockerfile (/data). Mount a persistent volume there.
# DATA_DIR=/data

# Optional: the verification code from Google Search Console (HTML tag method), without the <meta> wrapper.
# GOOGLE_SITE_VERIFICATION=
